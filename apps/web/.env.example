# Server-only credentials. Never expose the service-role key to a browser/device.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Prisma runtime connection: Supabase PostgreSQL pooler or direct PostgreSQL URL.
DATABASE_URL=
# Prisma CLI connection: direct URL or Supabase session pooler (port 5432).
# Falls back to DATABASE_URL when omitted.
DIRECT_URL=
